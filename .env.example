# DeliveryHub Environment Configuration
# Copy to .env and customize for your environment

# ===========================================
# Database Configuration
# ===========================================
# Order Service Database
ORDER_DB_HOST=postgres-order
ORDER_DB_PORT=5432
ORDER_DB_NAME=order_db
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=order_password

# Driver Service Database
DRIVER_DB_HOST=postgres-driver
DRIVER_DB_PORT=5432
DRIVER_DB_NAME=driver_db
DRIVER_DB_USER=driver_user
DRIVER_DB_PASSWORD=driver_password

# Notification Service Database
NOTIFICATION_DB_HOST=postgres-notification
NOTIFICATION_DB_PORT=5432
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=notification_password

# ===========================================
# Kafka Configuration
# ===========================================
KAFKA_BROKERS=kafka:9092
KAFKA_CONSUMER_GROUP_ORDER=order-service-group
KAFKA_CONSUMER_GROUP_DISPATCH=dispatch-service-group
KAFKA_CONSUMER_GROUP_NOTIFICATION=notification-service-group
KAFKA_CONSUMER_GROUP_DRIVER=driver-service-group

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================================
# Keycloak Configuration
# ===========================================
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=deliveryhub
KEYCLOAK_CLIENT_ID=delivery-client
KEYCLOAK_CLIENT_SECRET=delivery-secret
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ===========================================
# Service Configuration
# ===========================================
# API Gateway
GATEWAY_PORT=8080
GATEWAY_RATE_LIMIT_RPS=100
GATEWAY_RATE_LIMIT_BURST=200

# Order Service
ORDER_SERVICE_PORT=8081
ORDER_SERVICE_GRPC_PORT=9091

# Driver Service
DRIVER_SERVICE_PORT=8082
DRIVER_SERVICE_GRPC_PORT=9092

# Dispatch Service
DISPATCH_SERVICE_PORT=8083
DISPATCH_SERVICE_GRPC_PORT=9093

# Notification Service
NOTIFICATION_SERVICE_PORT=8084
NOTIFICATION_SERVICE_GRPC_PORT=9094

# AI Service
AI_SERVICE_PORT=8085
AI_SERVICE_GRPC_PORT=9095

# ===========================================
# AI Configuration
# ===========================================
AI_PROVIDER=MOCK
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4

# ===========================================
# Observability
# ===========================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=deliveryhub
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
PROMETHEUS_ENDPOINT=http://prometheus:9090

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===========================================
# Notification Providers (Optional - uses mock if not set)
# ===========================================
# SendGrid (Email)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@deliveryhub.com
SENDGRID_FROM_NAME=DeliveryHub

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Firebase (Push)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=